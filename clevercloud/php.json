{
  "deploy": {
        "documentRoot": "public",
    "postdeploy": [
      "php artisan migrate --force",
      "php artisan config:cache",
      "php artisan route:cache",
      "php artisan view:cache"
    ]
  },
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  },
    "apache": {
        "configFile": "clevercloud/apache.conf"
    }
}
